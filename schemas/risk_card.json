{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskCard",
  "description": "Risk Agent 출력. Tier 1 regime gate + Tier 2 position-level 제약 적용 결과. AI #1이 생성.",
  "type": "object",
  "required": ["risk_id", "snapshot_dt", "artifact_version", "regime", "tier1_pass", "portfolio_constraints", "position_risks"],
  "properties": {
    "risk_id": {
      "type": "string",
      "pattern": "^RC-\\d{8}-\\d{6}$"
    },
    "snapshot_dt": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_version": {
      "type": "string",
      "description": "스키마 버전 (e.g., v1.0)"
    },
    "regime": {
      "type": "object",
      "required": ["label", "vix_proxy", "market_breadth"],
      "properties": {
        "label": {
          "type": "string",
          "enum": ["green", "yellow", "red"],
          "description": "시장 국면 판단"
        },
        "vix_proxy": {
          "type": ["number", "null"],
          "description": "변동성 프록시 지표 (Phase 1에서는 null 가능)"
        },
        "market_breadth": {
          "type": ["number", "null"],
          "description": "시장 폭 지표 (상승종목비율, Phase 1에서는 null 가능)"
        },
        "regime_reason": {
          "type": "string",
          "description": "국면 판단 근거"
        }
      }
    },
    "tier1_pass": {
      "type": "boolean",
      "description": "Tier 1 regime gate 통과 여부 (red → false: 신규 진입 금지, 기존 포지션은 유지/청산 판단)"
    },
    "uq_enabled": {
      "type": "boolean",
      "description": "UQ tail cap 활성화 여부 (ablation 추적용). disable_uq=True이면 false, 아니면 YAML enabled 값을 따름."
    },
    "portfolio_constraints": {
      "type": "object",
      "description": "포트폴리오 레벨 제약",
      "properties": {
        "max_position_count": { "type": "integer", "description": "최대 보유 종목 수" },
        "max_single_weight": { "type": "number", "description": "단일 종목 최대 비중 (%)" },
        "max_sector_weight": { "type": "number", "description": "단일 섹터 최대 비중 (%)" },
        "max_total_exposure": { "type": "number", "description": "총 투자 비중 상한 (%)" }
      }
    },
    "llm_risk_analysis": {
      "type": ["object", "null"],
      "description": "Kanana-o가 생성한 리스크 내러티브 (LLM 실패 시 null)",
      "properties": {
        "risk_narrative": { "type": "string", "description": "리스크 분석 3~4문장 (한국어)" },
        "risk_level": {
          "type": "string",
          "enum": ["low", "moderate", "elevated", "high"],
          "description": "리스크 수준 판단"
        },
        "attention_items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "주의 필요 항목 키워드 배열"
        },
        "model_used": { "type": "string", "description": "사용된 LLM 모델명" }
      }
    },
    "position_risks": {
      "type": "array",
      "description": "종목별 리스크 평가",
      "items": {
        "type": "object",
        "required": ["ticker", "risk_flag", "approved_weight"],
        "properties": {
          "ticker": { "type": "string" },
          "risk_flag": {
            "type": "string",
            "enum": ["pass", "cap", "reject"],
            "description": "pass=통과, cap=비중제한, reject=거부"
          },
          "approved_weight": {
            "type": "number",
            "description": "승인된 비중 (%)"
          },
          "uncertainty_p85": {
            "type": ["number", "null"],
            "description": "P85 uncertainty tail 값 (Phase 1에서는 null, Phase 2+에서 활성화)"
          },
          "uncertainty_score": {
            "type": ["number", "null"],
            "description": "UQ 모델 예측 uncertainty_score (0~1). 모델 없을 때 null."
          },
          "uq_cap_applied": {
            "type": "boolean",
            "description": "UQ tail cap 적용 여부. UQ disabled이거나 threshold 미초과 시 false."
          },
          "weight_before_cap": {
            "type": ["number", "null"],
            "description": "UQ tail cap 적용 전 비중 (%). cap 미적용 시 null."
          },
          "weight_after_cap": {
            "type": ["number", "null"],
            "description": "UQ tail cap 적용 후 비중 (%). cap 미적용 시 null."
          },
          "holding_days": {
            "type": "integer",
            "description": "포지션 보유 일수 (PFS 없으면 0)"
          },
          "entry_price": {
            "type": ["number", "null"],
            "description": "진입 가격 (PFS 없으면 null)"
          },
          "unrealized_pnl_pct": {
            "type": ["number", "null"],
            "description": "미실현 손익률 % (PFS 없으면 null)"
          },
          "reason": { "type": "string" },
          "reasons": {
            "type": "array",
            "items": { "type": "string" },
            "description": "veto/cap 사유 목록 (복수 사유 지원). reason 필드와 병행 유지."
          }
        }
      }
    }
  }
}
