{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateOrderPlan",
  "description": "Risk Agent → Final Decision Agent. 리스크 필터링 완료된 후보 주문 계획. Risk Agent가 생성, Final Decision Agent는 approve/veto만 가능 (비중 재계산 불가).",
  "type": "object",
  "required": ["plan_id", "snapshot_dt", "artifact_version", "regime", "execution_time", "orders", "portfolio_summary"],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^COP-\\d{8}-\\d{6}$"
    },
    "snapshot_dt": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_version": {
      "type": "string",
      "description": "스키마 버전 (e.g., v1.0)"
    },
    "execution_time": {
      "type": "string",
      "description": "목표 집행 시점 (e.g., t+1 open)"
    },
    "regime": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "orders": {
      "type": "array",
      "description": "개별 주문 후보 리스트",
      "items": {
        "type": "object",
        "required": ["ticker", "action", "weight", "signal", "confidence"],
        "properties": {
          "ticker": { "type": "string" },
          "name": { "type": "string" },
          "action": {
            "type": "string",
            "enum": ["buy", "hold", "sell"]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "포트폴리오 내 목표 비중 (%)"
          },
          "signal": {
            "type": "string",
            "enum": ["strong_buy", "buy", "hold", "sell", "strong_sell"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": { "type": "string" },
          "risk_flag": {
            "type": "string",
            "enum": ["pass", "cap"]
          },
          "risk_tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "적용된 리스크 태그 (e.g., sector_cap, uq_tail_cap, low_liquidity)"
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "근거 아티팩트 ID 목록 (StrategyCard.evidence_ids 전달)"
          },
          "uncertainty_p85": {
            "type": ["number", "null"],
            "description": "P85 uncertainty score (UQ 모델 없으면 null, Phase 2+에서 활성화)"
          },
          "sizing_rule": {
            "type": ["string", "null"],
            "description": "비중 산정 규칙 (e.g., equal_weight, risk_parity, confidence_scaled)"
          },
          "sell_reason": {
            "type": ["string", "null"],
            "description": "sell 사유 (stop_loss, signal_sell, regime_red 등). action=sell일 때만 사용, 그 외 null"
          },
          "pre_risk_score": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
          "quant_score": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
          "news_signal": {"type": ["number", "null"]},
          "source_strategy": {"type": ["string", "null"]},
          "features_used": {"type": "array", "items": {"type": "string"}},
          "uncertainty_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "portfolio_summary": {
      "type": "object",
      "properties": {
        "total_exposure": { "type": "number", "description": "총 투자 비중 (%)" },
        "cash_ratio": { "type": "number", "description": "현금 비율 (%)" },
        "position_count": { "type": "integer" },
        "sector_breakdown": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "description": "섹터별 비중 (%)"
        }
      }
    }
  }
}
