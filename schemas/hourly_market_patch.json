{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HourlyMarketPatch",
  "description": "장중 1시간 단위 delta 업데이트 — daily backbone 위에 얹는 증분 패킷",
  "type": "object",
  "required": ["patch_id", "snapshot_dt", "artifact_version", "base_dmp_id", "changed_tickers", "price_patch"],
  "properties": {
    "patch_id": {
      "type": "string",
      "pattern": "^HMP-\\d{8}-\\d{6}$",
      "description": "HMP-YYYYMMDD-HHMMSS"
    },
    "snapshot_dt": {
      "type": "string",
      "description": "ISO 8601 datetime with timezone"
    },
    "artifact_version": {
      "type": "string"
    },
    "base_dmp_id": {
      "type": "string",
      "description": "이 patch가 기반으로 하는 DMP의 packet_id"
    },
    "changed_tickers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "가격/뉴스가 변한 종목 리스트"
    },
    "price_patch": {
      "type": "object",
      "description": "ticker별 장중 가격 업데이트",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "last": { "type": "number", "description": "현재가" },
          "chg_pct": { "type": "number", "description": "전일 종가 대비 등락률 (%)" },
          "volume_intraday": { "type": "integer", "description": "장중 누적 거래량" }
        }
      }
    },
    "new_evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "이전 snapshot 이후 새로 발생한 뉴스/공시 evidence_id"
    },
    "market_stress_update": {
      "type": ["object", "null"],
      "description": "장중 시장 스트레스 업데이트",
      "properties": {
        "vix_proxy": { "type": ["number", "null"] },
        "market_breadth": { "type": ["number", "null"] }
      }
    }
  }
}
