{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrokerReconcileReport",
  "description": "PFS ↔ Paper Trading 대조 리포트",
  "type": "object",
  "required": ["report_id", "target_date", "generated_at", "status", "mismatches"],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^BRR-\\d{8}$"
    },
    "target_date": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "mismatch", "error"]
    },
    "pfs_positions": {
      "type": "integer"
    },
    "ptl_orders": {
      "type": "integer"
    },
    "mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "pfs_value": {},
          "ptl_value": {},
          "description": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
