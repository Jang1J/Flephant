# === API Keys ===
# 각자 .env 파일을 만들어서 실제 키를 넣으세요 (.env는 .gitignore에 포함)

# OpenDART
DART_API_KEY=your_dart_api_key_here

# Naver 검색 API
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# ECOS (한국은행)
ECOS_API_KEY=your_ecos_api_key_here

# KRX Open API
KRX_API_KEY=your_krx_api_key_here

# Kanana-o
KANANA_API_KEY=your_kanana_api_key_here
KANANA_BASE_URL=https://api.kanana.ai/v1

# GPT-4o (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# KIS 모의투자 API (Phase 2+)
# 실계좌 전환 전에는 반드시 virtual 유지. 실제 .env는 저장소/zip에 포함 금지.
KIS_MODE=virtual
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=
KIS_ACCOUNT_PRODUCT_CODE=

# Optional: paper/live key alias를 쓰는 개인 shell에서 아래처럼 매핑
# export KIS_MODE=virtual
# export KIS_APP_KEY="$KIS_PAPER_APP_KEY"
# export KIS_APP_SECRET="$KIS_PAPER_APP_SECRET"
# export KIS_ACCOUNT_NUMBER="$KIS_PAPER_ACCOUNT_NUMBER"
# export KIS_ACCOUNT_PRODUCT_CODE="$KIS_PAPER_ACCOUNT_PRODUCT_CODE"
